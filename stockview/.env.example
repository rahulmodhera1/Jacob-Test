# Copy to .env.local and fill in your keys (both optional — the app runs on demo data without them)

# Live quotes, symbol search, market cap — https://finnhub.io (free tier: 60 req\/min)
FINNHUB_API_KEY=

# Real historical chart data + volume — https://twelvedata.com (free tier: 8 req\/min, 800\/day)
TWELVEDATA_API_KEY=
